-- [[ STANDALONE ELITE AUTO-ZONE WITH LOGGING ]] --
-- Оптимизировано для Delta Mobile

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer

local SETTINGS = {
    Interval = 10, -- Как часто проверять зону (сек)
    DebugMode = true -- Выводить ли подробные логи в консоль
}

-- Функция логирования
local function Log(msg, isError)
    local timestamp = os.date("%X")
    local prefix = "[AutoZone "..timestamp.."] "
    if isError then
        warn(prefix .. "❌ ERROR: " .. tostring(msg))
    elseif SETTINGS.DebugMode then
        print(prefix .. "ℹ️ " .. tostring(msg))
    end
end

-- Динамический поиск Remotes
local function getRemotesFolder()
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    if not packages then return nil, "Packages not found in ReplicatedStorage" end
    local index = packages:FindFirstChild("_Index")
    if not index then return nil, "_Index not found in Packages" end
    
    for _, child in ipairs(index:GetChildren()) do
        if child.Name:find("networker") then
            local networker = child:FindFirstChild("networker")
            if networker then
                local remotes = networker:FindFirstChild("_remotes")
                if remotes then return remotes end
            end
        end
    end
    return nil, "Networker remotes folder not found"
end

-- Диагностика при запуске
local function runDiagnostics()
    Log("=== REMOTE DIAGNOSTICS ===")
    
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    if not packages then
        Log("Packages NOT FOUND in ReplicatedStorage", true)
        Log("ReplicatedStorage children: "..table.concat(
            (function() local t = {} for _, c in ipairs(ReplicatedStorage:GetChildren()) do table.insert(t, c.Name.."["..c.ClassName.."]") end return t end)(), ", "))
        return
    end
    Log("Packages found ✓")
    
    local index = packages:FindFirstChild("_Index")
    if not index then
        Log("_Index NOT FOUND in Packages", true)
        Log("Packages children: "..table.concat(
            (function() local t = {} for _, c in ipairs(packages:GetChildren()) do table.insert(t, c.Name.."["..c.ClassName.."]") end return t end)(), ", "))
        return
    end
    Log("_Index found ✓")
    
    local indexChildren = {}
    for _, child in ipairs(index:GetChildren()) do
        table.insert(indexChildren, child.Name)
    end
    Log("_Index children: "..table.concat(indexChildren, ", "))
    
    local folder = getRemotesFolder()
    if not folder then
        Log("Remotes folder NOT FOUND", true)
        return
    end
    Log("Remotes folder found ✓")
    
    local services = {}
    for _, child in ipairs(folder:GetChildren()) do
        table.insert(services, child.Name)
    end
    Log("Available services: "..table.concat(services, ", "))
    
    local zonesService = folder:FindFirstChild("ZonesService")
    if zonesService then
        Log("ZonesService found ✓")
        local funcs = {}
        for _, child in ipairs(zonesService:GetChildren()) do
            table.insert(funcs, child.Name.."["..child.ClassName.."]")
        end
        Log("ZonesService contents: "..table.concat(funcs, ", "))
    else
        Log("ZonesService NOT FOUND in remotes!", true)
        Log("Try one of: "..table.concat(services, ", "))
    end
    
    Log("=== END DIAGNOSTICS ===")
end

runDiagnostics()

local function callRemote(service, method, ...)
    local folder, err = getRemotesFolder()
    if not folder then return false, err end
    
    local remote = folder:FindFirstChild(service)
    if not remote then return false, "Service '"..service.."' not found. Available: "..table.concat(
        (function() local t = {} for _, c in ipairs(folder:GetChildren()) do table.insert(t, c.Name) end return t end)(), ", ") end
    
    local func = remote:FindFirstChild("RemoteFunction")
    if not func then
        local children = {}
        for _, c in ipairs(remote:GetChildren()) do table.insert(children, c.Name.."["..c.ClassName.."]") end
        return false, "RemoteFunction not found in '"..service.."'. Contents: "..table.concat(children, ", ")
    end
    
    local ok, result = pcall(function(...)
        return func:InvokeServer(...)
    end, method, ...)
    
    return ok, result
end

local function Teleport(zoneId)
    Log("Attempting teleport to zone: " .. tostring(zoneId))
    local ok, result = callRemote("ZonesService", "requestTeleportZone", zoneId)
    if not ok then
        Log("Teleport FAILED: " .. tostring(result), true)
    else
        Log("Teleport sent OK. Server response: "..tostring(result))
    end
end

local function TeleportBestZone()
    Log("Starting zone scan...")
    local zonesFolder = workspace:FindFirstChild("Zones")
    if not zonesFolder then 
        Log("Zones folder not found in Workspace!", true)
        return 
    end
    
    local zones = zonesFolder:GetChildren()
    table.sort(zones, function(a, b)
        local numA = tonumber(a.Name:match("%d+")) or 0
        local numB = tonumber(b.Name:match("%d+")) or 0
        return numA < numB
    end)

    local bestZoneId = 1
    local lastOpened = 1

    for _, zone in ipairs(zones) do
        local zoneNum = tonumber(zone.Name:match("%d+"))
        if not zoneNum then continue end
        
        local gate = zone:FindFirstChild("Gate")
        local isOpened = false
        
        if gate then
            -- Дамп содержимого Gate для дебага
            if SETTINGS.DebugMode then
                local parts = {}
                for _, child in ipairs(gate:GetDescendants()) do
                    if child:IsA("BasePart") then
                        table.insert(parts, child.Name.."(collide="..tostring(child.CanCollide)..",transp="..string.format("%.1f", child.Transparency)..")") 
                    end
                end
                Log("Zone "..zoneNum.." Gate contents: "..table.concat(parts, ", "))
            end

            -- 1. Проверяем именованный блокировщик
            local blocker = gate:FindFirstChild("ClientGateBlocker_" .. zone.Name) or gate:FindFirstChild("GateBlocker")
            if blocker then
                if blocker.CanCollide then
                    isOpened = false
                    Log("Zone "..zoneNum.." is LOCKED (named blocker CanCollide=true).")
                else
                    isOpened = true
                    Log("Zone "..zoneNum.." is OPEN (named blocker CanCollide=false).")
                end
            else
                -- 2. Нет именованного блокировщика — проверяем есть ли часть с CanCollide=true
                local hasCollider = false
                for _, child in ipairs(gate:GetDescendants()) do
                    if child:IsA("BasePart") and child.CanCollide == true then
                        hasCollider = true
                        Log("Zone "..zoneNum.." is LOCKED ("..child.Name.." CanCollide=true).")
                        break
                    end
                end
                if hasCollider then
                    isOpened = false
                else
                    isOpened = true
                    Log("Zone "..zoneNum.." is OPEN (all parts CanCollide=false).")
                end
            end
        else
            isOpened = true
            Log("Zone "..zoneNum.." has no Gate folder, assuming opened.")  
        end

        if isOpened then
            lastOpened = zoneNum
            bestZoneId = zoneNum
        else
            -- Логика +1 (прыгаем в следующую за последней открытой)
            bestZoneId = zoneNum
            Log("Zone "..zoneNum.." is locked. Applying +1 logic. Final target: "..bestZoneId)
            break
        end
    end
    
    Teleport(bestZoneId)
end

-- Запуск цикла
task.spawn(function()
    Log("Script started. Check interval: " .. SETTINGS.Interval .. "s")
    while true do
        local ok, err = pcall(TeleportBestZone)
        if not ok then
            Log("Critical Loop Error: " .. tostring(err), true)
        end
        task.wait(SETTINGS.Interval)
    end
end)

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "AutoZone Logger",
    Text = "Script started! Press F9 to see logs.",
    Duration = 5
})
