-- [[ STANDALONE ELITE AUTO-ZONE WITH LOGGING ]] --
-- Оптимизировано для Delta Mobile

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer
local client, clientHRP

local function updateCharacter()
    client = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    clientHRP = client:WaitForChild("HumanoidRootPart", 10)
    if not clientHRP then
        task.wait(1)
        return updateCharacter()
    end
end
updateCharacter()
localPlayer.CharacterAdded:Connect(updateCharacter)

local SETTINGS = {
    Interval = 10, -- Как часто проверять зону (сек)
    DebugMode = true -- Выводить ли подробные логи в консоль
}

-- Функция логирования
local function Log(msg, isError)
    local timestamp = os.date("%X")
    local prefix = "[AutoZone "..timestamp.."] "
    if isError then
        warn(prefix .. "ERROR: " .. tostring(msg))
    elseif SETTINGS.DebugMode then
        print(prefix .. tostring(msg))
    end
end

-- Динамический поиск Remotes (проверяет ВСЕ версии networker)
local function getAllRemotesFolders()
    local result = {}
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    if not packages then return result end
    local index = packages:FindFirstChild("_Index")
    if not index then return result end
    
    for _, child in ipairs(index:GetChildren()) do
        if child.Name:find("networker") then
            local networker = child:FindFirstChild("networker")
            if networker then
                local remotes = networker:FindFirstChild("_remotes")
                if remotes then
                    table.insert(result, {folder = remotes, version = child.Name})
                end
            end
        end
    end
    return result
end

local function findRemoteService(serviceName)
    local folders = getAllRemotesFolders()
    for _, entry in ipairs(folders) do
        local remote = entry.folder:FindFirstChild(serviceName)
        if remote then
            return remote, entry.version
        end
    end
    return nil
end

-- Диагностика при запуске
local function runDiagnostics()
    Log("=== REMOTE DIAGNOSTICS ===")
    local folders = getAllRemotesFolders()
    if #folders == 0 then
        Log("No networker remotes found!", true)
        return
    end
    for _, entry in ipairs(folders) do
        local services = {}
        for _, c in ipairs(entry.folder:GetChildren()) do
            table.insert(services, c.Name)
        end
        Log(entry.version.." services: "..table.concat(services, ", "))
    end
    local zs, ver = findRemoteService("ZonesService")
    if zs then
        Log("ZonesService found in "..ver)
    else
        Log("ZonesService NOT FOUND in any networker!", true)
    end
    Log("=== END DIAGNOSTICS ===")
end

runDiagnostics()

local function callRemote(service, method, ...)
    local remote = findRemoteService(service)
    if not remote then return false, "Service '"..service.."' not found in any networker" end
    
    local func = remote:FindFirstChild("RemoteFunction")
    if not func then return false, "RemoteFunction not found in '"..service.."'" end
    
    local ok, result = pcall(function(...)
        return func:InvokeServer(...)
    end, method, ...)
    
    return ok, result
end

local function Teleport(zoneId)
    Log("Attempting teleport to zone: " .. tostring(zoneId))
    local ok, result = callRemote("ZonesService", "requestTeleportZone", zoneId)
    if ok then
        Log("Teleport OK. Response: "..tostring(result))
    else
        Log("Teleport FAILED: " .. tostring(result), true)
    end
end

local function TeleportBestZone()
    Log("Starting zone scan...")
    local zonesFolder = workspace:FindFirstChild("Zones")
    if not zonesFolder then 
        Log("Zones folder not found in Workspace!", true)
        return 
    end
    
    local zones = zonesFolder:GetChildren()
    table.sort(zones, function(a, b)
        local numA = tonumber(a.Name:match("%d+")) or 0
        local numB = tonumber(b.Name:match("%d+")) or 0
        return numA < numB
    end)

    local bestZoneId = 1
    local lastOpened = 1

    for _, zone in ipairs(zones) do
        local zoneNum = tonumber(zone.Name:match("%d+"))
        if not zoneNum then continue end
        
        local gate = zone:FindFirstChild("Gate")
        local isOpened = false
        
        if gate then
            -- Дамп содержимого Gate для дебага
            if SETTINGS.DebugMode then
                local parts = {}
                for _, child in ipairs(gate:GetDescendants()) do
                    if child:IsA("BasePart") then
                        table.insert(parts, child.Name.."(collide="..tostring(child.CanCollide)..")") 
                    end
                end
                Log("Zone "..zoneNum.." Gate: "..table.concat(parts, ", "))
            end

            -- 1. Проверяем именованный блокировщик
            local blocker = gate:FindFirstChild("ClientGateBlocker_" .. zone.Name) or gate:FindFirstChild("GateBlocker")
            if blocker then
                if blocker.CanCollide then
                    isOpened = false
                    Log("Zone "..zoneNum.." LOCKED (blocker CanCollide=true)")
                else
                    isOpened = true
                    Log("Zone "..zoneNum.." OPEN (blocker CanCollide=false)")
                end
            else
                -- 2. Нет именованного блокировщика — проверяем есть ли часть с CanCollide=true
                local hasCollider = false
                for _, child in ipairs(gate:GetDescendants()) do
                    if child:IsA("BasePart") and child.CanCollide == true then
                        hasCollider = true
                        Log("Zone "..zoneNum.." LOCKED ("..child.Name.." CanCollide=true)")
                        break
                    end
                end
                if hasCollider then
                    isOpened = false
                else
                    isOpened = true
                    Log("Zone "..zoneNum.." OPEN (all parts CanCollide=false)")
                end
            end
        else
            isOpened = true
            Log("Zone "..zoneNum.." OPEN (no Gate folder)")
        end

        if isOpened then
            lastOpened = zoneNum
            bestZoneId = zoneNum
        else
            bestZoneId = zoneNum
            Log("Zone "..zoneNum.." locked. +1 logic. Target: "..bestZoneId)
            break
        end
    end
    
    Teleport(bestZoneId)
end

-- Запуск цикла
task.spawn(function()
    Log("Script started. Check interval: " .. SETTINGS.Interval .. "s")
    while true do
        local ok, err = pcall(TeleportBestZone)
        if not ok then
            Log("Critical Loop Error: " .. tostring(err), true)
        end
        task.wait(SETTINGS.Interval)
    end
end)

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "AutoZone",
    Text = "Script started! Press F9 for logs.",
    Duration = 5
})
