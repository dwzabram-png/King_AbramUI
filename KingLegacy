-- 2. ОСНОВНОЙ ЦИКЛ ФАРМА В ДАНЖЕ
task.spawn(function()
    while autoDungeon do
        task.wait(0.1) -- Задержка, чтобы не крашнуть игру спамом InvokeServer

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        local hrp = char.HumanoidRootPart

        -- Проверка этажа
        local currentFloor = getFloorText()
        if currentFloor then
            -- Логика: если перешли с 1/5 на 2/5, нужно закрыть зону
            if currentFloor == "2/5" and lastFloor == "1/5" then
                if isRoomActive() then
                    toggleRoom("Up") -- Закрываем зону
                    task.wait(1) -- Ждем серверной регистрации закрытия
                end
            end
            lastFloor = currentFloor -- Обновляем память об этаже

            -- Если мы находимся в данже (есть текст "1/5", "2/5" и т.д.)
            if string.find(currentFloor, "/5") then
                local mob = getValidMob()
                
                if mob then
                    local mobHRP = mob:FindFirstChild("HumanoidRootPart")
                    
                    -- Зависаем над мобом лежа (math.rad(-90) кладет персонажа лицом вниз горизонтально)
                    -- Высота 15 стадов над головой моба
                    hrp.CFrame = mobHRP.CFrame * CFrame.new(0, 15, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                    
                    -- Сбрасываем физику падения (чтобы перс не падал вниз)
                    hrp.Velocity = Vector3.new(0, 0, 0)

                    -- Если зоны нет - открываем её
                    if not isRoomActive() then
                        toggleRoom("Down")
                        task.wait(0.5) -- Небольшая задержка, чтобы зона успела появиться
                    end

                    -- Бьем моба Kioru V2
                    attackTarget(mobHRP.CFrame)
                end
            end
        end
    end
end)

