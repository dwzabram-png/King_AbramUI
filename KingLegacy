local P = game:GetService("Players")
local R = game:GetService("ReplicatedStorage")
local RS = game:GetService("RunService")

local L = P.LocalPlayer
local Ch = R:WaitForChild("Chest")
local Re = Ch:WaitForChild("Remotes")
local Fu = Re:WaitForChild("Functions")
local Ev = Re:WaitForChild("Events")

local SA = Fu:WaitForChild("SkillAction")
local SD = Fu:WaitForChild("SelectDungeon")
local AE = Ev:WaitForChild("Armament")
local KE = Fu:WaitForChild("KenEvent")

local auto = true
local lastF = ""
local startCF = CFrame.new(10959.46, 141.89, 1252.01)
local lHeal = 0
local lSkill = 0

-- Проверка КД расы
local function isRaceCD()
    local g = L.PlayerGui:FindFirstChild("MainGui")
    if g then
        local r = g.BaseFrame.Frame:FindFirstChild("RaceFrame")
        if r and r:FindFirstChild("Cooldown") then return r.Cooldown.Visible end
    end
    return false
end

-- Доджи для KenV2
local function getD()
    local d = 0
    pcall(function() d = L.Character.Haki.Observation.Value end)
    if d == 0 then pcall(function() d = L.Haki.Observation.Value end) end
    return d
end

-- Менеджер KenV2 (по твоим условиям)
local function manageKen(hp)
    local d = getD()
    local active = L.Character and L.Character:FindFirstChild("KenHaki")
    if hp <= 15000 and isRaceCD() and d >= 5 then
        if not active then KE:InvokeServer() end
    elseif active and d < 5 then
        KE:InvokeServer()
    end
end

-- Хил
local function heal()
    if tick() - lHeal < 60 then return end
    local h = math.huge
    local g = L.PlayerGui:FindFirstChild("MainGui")
    if g then
        pcall(function()
            local t = g.BaseFrame.Frame.HealthFrame.HealthText.Text
            h = tonumber(t:split("/")[1]:gsub("%D", "")) or h
        end)
    end
    if h == math.huge and L.Character and L.Character:FindFirstChild("Humanoid") then h = L.Character.Humanoid.Health end
    manageKen(h)
    if h <= 15000 then
        task.spawn(function() pcall(function() SA:InvokeServer("RC") end) end)
        lHeal = tick()
    end
end

-- Каст (Down/Up)
local function fire(name, cf)
    task.spawn(function()
        pcall(function() SA:InvokeServer(name, {["Type"] = "Down", ["MouseHit"] = cf}) end)
        pcall(function() SA:InvokeServer(name, {["Type"] = "Up", ["MouseHit"] = cf}) end)
    end)
end

-- Жесткий флай
RS.Heartbeat:Connect(function()
    if auto and L.Character and L.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = L.Character.HumanoidRootPart
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if not hrp:FindFirstChild("DH") then
            local b = Instance.new("BodyVelocity")
            b.Name = "DH"; b.MaxForce = Vector3.new(math.huge, math.huge, math.huge); b.Velocity = Vector3.zero; b.Parent = hrp
        end
    end
end)

-- Рестарт данжа
task.spawn(function()
    while auto do
        task.wait(2)
        pcall(function() AE:FireServer() end)
        if L.Character and L.Character:FindFirstChild("HumanoidRootPart") then
            local res = L.PlayerGui:FindFirstChild("DungeonResult")
            local dist = (L.Character.HumanoidRootPart.Position - startCF.Position).Magnitude
            if (res and res.Enabled) or (not L.PlayerGui:FindFirstChild("DungeonUI") and dist > 1000) then
                L.Character.HumanoidRootPart.CFrame = startCF
                task.wait(2)
                pcall(function() SD:InvokeServer("Hard") end)
                task.wait(5)
            end
        end
    end
end)

-- Цикл атаки
task.spawn(function()
    while auto do
        task.wait(0.05)
        pcall(function()
            local char = L.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            heal()
            
            if L.PlayerGui:FindFirstChild("DungeonUI") then
                local mob = nil
                local f = workspace:FindFirstChild("MOB")
                if f then
                    for _, m in pairs(f:GetChildren()) do
                        if m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 then mob = m; break end
                    end
                end

                if mob then
                    local mH = mob.HumanoidRootPart.CFrame
                    local isB = mob.Humanoid.MaxHealth > 1000000
                    
                    hrp.CFrame = mH * CFrame.new(0, isB and 11 or 15, 0) * CFrame.Angles(math.rad(-90), 0, 0)

                    -- M1 + скиллы Dawnbreaker
                    if tick() - lSkill >= (isB and 0.5 or 1) then
                        fire("SW_Dawnbreaker_Z", mH)
                        fire("SW_Dawnbreaker_X", mH)
                        fire("DF_MagmaMagma_Z", mH)
                        fire("DF_MagmaMagma_X", mH)
                        fire("DF_MagmaMagma_C", mH)
                        fire("DF_MagmaMagma_V", mH)
                        lSkill = tick()
                    end
                end
            end
        end)
    end
end)

