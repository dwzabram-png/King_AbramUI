local SelectDungeon = Functions:WaitForChild("SelectDungeon")
local ArmamentEvent = Events:WaitForChild("Armament")

local autoDungeon = true
local lastFloor = ""
local startCFrame = CFrame.new(10959.46, 141.89, 1252.01)
local togglingRoom = false
local lastHealTime = 0
local lastSkillTime = 0

-- 1. АКТИВАЦИЯ ВОЛИ ПРИ ЗАПУСКЕ
task.spawn(function()
    print("[KL-DELTA] Активация Воли Вооружения...")
    pcall(function()
        ArmamentEvent:FireServer()
    end)
end)

-- Функция авто-хила
local function checkAndHeal()
    if tick() - lastHealTime < 60 then return end
    
    local currentHP = math.huge
    local gui = LocalPlayer.PlayerGui:FindFirstChild("MainGui")
    if gui then
        local healthFrame = gui:FindFirstChild("BaseFrame") 
            and gui.BaseFrame:FindFirstChild("Frame") 
            and gui.BaseFrame.Frame:FindFirstChild("HealthFrame")
            
        if healthFrame and healthFrame:FindFirstChild("HealthText") then
            local text = healthFrame.HealthText.Text
            local firstPart = text:split("/")[1]
            if firstPart then
                local cleanNumbers = firstPart:gsub("%D", "")
                currentHP = tonumber(cleanNumbers) or math.huge
            end
        end
    end
    
    if currentHP == math.huge then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            currentHP = char.Humanoid.Health
        end
    end

    if currentHP <= 15000 then
        print("[KL-DELTA] Низкое HP: " .. currentHP .. ". Хил RC.")
        task.spawn(function()
            pcall(function()
                SkillAction:InvokeServer("RC")
            end)
        end)
        lastHealTime = tick()
    end
end

-- Проверка зоны (Room)
local function isRoomActive()
    return workspace:FindFirstChild("OpeRoom" .. LocalPlayer.Name) ~= nil
end

-- Проверка, находится ли игрок внутри зоны
local function isPlayerInRoom()
    local room = workspace:FindFirstChild("OpeRoom" .. LocalPlayer.Name)
    if not room then return false end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local playerPos = char.HumanoidRootPart.Position
    local roomPos = room.Position
    local radius = (math.max(room.Size.X, room.Size.Z) / 2) * 0.9 
    local distance = (roomPos - playerPos).Magnitude
    return distance <= radius
end

-- Моментальное Открытие/закрытие зоны
local function toggleRoom(targetCFrame)
    if togglingRoom then return end
    togglingRoom = true
    local cleanCFrame = CFrame.new(targetCFrame.Position)
    task.spawn(function()
        pcall(function() SkillAction:InvokeServer("DF_OpOp_Z", { ["Type"] = "Down", ["MouseHit"] = cleanCFrame }) end)
        pcall(function() SkillAction:InvokeServer("DF_OpOp_Z", { ["Type"] = "Up", ["MouseHit"] = cleanCFrame }) end)
        task.wait(1) -- Защита от двойного прока
        togglingRoom = false
    end)
end

-- Моментальный каст скилла без проверки КД
local function fireSkill(skillName, targetCFrame)
    task.spawn(function()
        pcall(function() SkillAction:InvokeServer(skillName, { ["Type"] = "Down", ["MouseHit"] = targetCFrame }) end)
        pcall(function() SkillAction:InvokeServer(skillName, { ["Type"] = "Up", ["MouseHit"] = targetCFrame }) end)
    end)
end

-- Поиск моба
local function getValidMob()
    local mobsFolder = workspace:FindFirstChild("MOB")
    if not mobsFolder then return nil end
    for _, mob in pairs(mobsFolder:GetChildren()) do
        local hum = mob:FindFirstChild("Humanoid")
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.Health > 0 then return mob end
    end
    return nil
end

-- Получение этажа
local function getFloorText()
    local gui = LocalPlayer.PlayerGui:FindFirstChild("DungeonUI")
    if gui and gui:FindFirstChild("DungeonFrame") and gui.DungeonFrame:FindFirstChild("Frame") then
        local floorsFrame = gui.DungeonFrame.Frame:FindFirstChild("FloorsFrame")
        if floorsFrame then
            local label = floorsFrame:FindFirstChild("TextLabel")
            if label then return label.Text end
        end
    end
    return nil
end

-- 2. ЖЕЛЕЗОБЕТОННЫЙ ФЛАЙ (Анти-Дергание)
RunService.Heartbeat:Connect(function()
    if autoDungeon then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            -- Жестко глушим инерцию и гравитацию каждый кадр
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            
            -- Страховочный BodyVelocity
            local floatFly = hrp:FindFirstChild("DeltaHover")
            if not floatFly then
                floatFly = Instance.new("BodyVelocity")
                floatFly.Name = "DeltaHover"
                floatFly.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                floatFly.Velocity = Vector3.zero
                floatFly.Parent = hrp
            end
        end
    end
end)

