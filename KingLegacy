local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")

local LocalPlayer = Players.LocalPlayer
local SkillAction = ReplicatedStorage:WaitForChild("Chest"):WaitForChild("Remotes"):WaitForChild("Functions"):WaitForChild("SkillAction")
local SelectDungeon = ReplicatedStorage.Chest.Remotes.Functions:WaitForChild("SelectDungeon")

local autoDungeon = true
local lastFloor = ""
local startCFrame = CFrame.new(10959.46, 141.89, 1252.01)

-- Флаг, чтобы скрипт не спамил открытием/закрытием зоны
local togglingRoom = false

-- Функция проверки, открыта ли зона (Room)
local function isRoomActive()
    return workspace:FindFirstChild("OpeRoom" .. LocalPlayer.Name) ~= nil
end

-- Обновленная функция открытия/закрытия зоны (работает без зависаний)
local function toggleRoom(targetCFrame)
    if togglingRoom then return end
    togglingRoom = true
    
    -- Берем только позицию, без углов поворота, чтобы зона не улетала
    local cleanCFrame = CFrame.new(targetCFrame.Position)

    -- 1. Зажимаем кнопку
    task.spawn(function()
        local argsDown = {
            [1] = "DF_OpOp_Z",
            [2] = { ["Type"] = "Down", ["MouseHit"] = cleanCFrame }
        }
        SkillAction:InvokeServer(unpack(argsDown))
    end)

    -- Ждем 0.5 сек и отпускаем кнопку
    task.delay(0.5, function()
        task.spawn(function()
            local argsUp = {
                [1] = "DF_OpOp_Z",
                [2] = { ["Type"] = "Up", ["MouseHit"] = cleanCFrame }
            }
            SkillAction:InvokeServer(unpack(argsUp))
        end)
        
        -- Даем зоне еще 0.5 секунд на прогрузку, прежде чем снять ограничение
        task.delay(0.5, function()
            togglingRoom = false
        end)
    end)
end

-- Функция атаки мечом Kioru V2
local function attackTarget(targetCFrame)
    task.spawn(function()
        local args = {
            [1] = "SW_Kioru V2_M1",
            [2] = { ["MouseHit"] = targetCFrame }
        }
        SkillAction:InvokeServer(unpack(args))
    end)
end

-- Функция поиска живого моба
local function getValidMob()
    local mobsFolder = workspace:FindFirstChild("MOB")
    if not mobsFolder then return nil end

    for _, mob in pairs(mobsFolder:GetChildren()) do
        local hum = mob:FindFirstChild("Humanoid")
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.Health > 0 then
            return mob
        end
    end
    return nil
end

-- Функция получения текущего этажа
local function getFloorText()
    local gui = LocalPlayer.PlayerGui:FindFirstChild("DungeonUI")
    if gui and gui:FindFirstChild("DungeonFrame") and gui.DungeonFrame:FindFirstChild("Frame") then
        local label = gui.DungeonFrame.Frame.FloorsFrame:FindFirstChild("TextLabel")
        if label then
            return label.Text
        end
    end
    return nil
end

-- 1. ТЕЛЕПОРТ И ЗАПУСК ДАНЖА
task.spawn(function()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    task.wait(1)
    
    -- Летим на место запуска
    if char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = startCFrame
    end

    -- Ждем интерфейс и запускаем Hard Mode
    local chooseMapGui = LocalPlayer.PlayerGui:WaitForChild("ChooseMap", 15)
    if chooseMapGui then
        task.wait(1) 
        local args = { [1] = "Hard" }
        SelectDungeon:InvokeServer(unpack(args))
        print("Данж Hard успешно запущен!")
    end
end)

-- 2. ОСНОВНОЙ ЦИКЛ ФАРМА
task.spawn(function()
    while autoDungeon do
        task.wait(0.05) -- Быстрый цикл для удержания в воздухе

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        local hrp = char.HumanoidRootPart

        local currentFloor = getFloorText()
        if currentFloor then
            
            -- ПРОВЕРКА ПЕРЕХОДА ЭТАЖА (с 1/5 на 2/5 и т.д.)
            if currentFloor == "2/5" and lastFloor == "1/5" then
                if isRoomActive() then
                    toggleRoom(hrp.CFrame) -- Закрываем зону
                    task.wait(1.5) -- Ждем пока закроется, чтобы не багалось
                end
            end
            lastFloor = currentFloor

            -- ЕСЛИ МЫ В ДАНЖЕ
            if string.find(currentFloor, "/5") then
                local mob = getValidMob()
                
                if mob then
                    local mobHRP = mob:FindFirstChild("HumanoidRootPart")
                    
                    -- Зависаем над мобом горизонтально (лицом вниз, высота +15 стадов)
                    hrp.CFrame = mobHRP.CFrame * CFrame.new(0, 15, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                    hrp.Velocity = Vector3.new(0, 0, 0) -- Убираем гравитацию

                    -- Если зоны нет - кастуем (функция асинхронная, не прервет удержание в воздухе)
                    if not isRoomActive() then
                        toggleRoom(hrp.CFrame)
                    else
                        -- Если зона есть - бьем моба мечом
                        attackTarget(mobHRP.CFrame)
                    end
                end
            end
        end
    end
end)

