-- 3. ОСНОВНОЙ ЦИКЛ ФАРМА
task.spawn(function()
    while autoDungeon do
        task.wait(0.05)
        
        local ok, err = pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart

            checkAndHeal()

            -- Анти-Дергание (Оставляем BodyVelocity, но на мобилках лучше так, чем без него)
            local hoverFly = hrp:FindFirstChild("HoverVelocity")
            if not hoverFly then
                hoverFly = Instance.new("BodyVelocity")
                hoverFly.Name = "HoverVelocity"
                hoverFly.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                hoverFly.Velocity = Vector3.new(0, 0, 0)
                hoverFly.Parent = hrp
            end

            local currentFloor = getFloorText()
            if currentFloor then
                if currentFloor ~= lastFloor then
                    print("[KL-DELTA] Этаж: " .. currentFloor)
                    if isRoomActive() then toggleRoom(hrp.CFrame) end
                    lastFloor = currentFloor
                end

                if string.find(currentFloor, "/5") then
                    local mob = getValidMob()
                    if mob then
                        local mobHRP = mob:FindFirstChild("HumanoidRootPart")
                        if not mobHRP then return end
                        local targetPos = mobHRP.CFrame
                        
                        hrp.CFrame = targetPos * CFrame.new(0, 15, 0) * CFrame.Angles(math.rad(-90), 0, 0)

                        if not isRoomActive() then
                            toggleRoom(targetPos)
                            task.wait(1.5)
                        elseif isRoomActive() and not isPlayerInRoom() then
                            toggleRoom(hrp.CFrame)
                            task.wait(1)
                            toggleRoom(hrp.CFrame)
                            task.wait(1.5)
                        else
                            -- M1
                            pcall(function()
                                SkillAction:InvokeServer("SW_Kioru V2_M1", { ["MouseHit"] = targetPos })
                            end)

                            if isReady("SWZ") then useSkill("SW_Kioru V2_Z", targetPos, "SWZ") end
                            if isReady("SWX") then useSkill("SW_Kioru V2_X", targetPos, "SWX") end

                            if isRoomActive() then
                                if isReady("DFX") then useSkill("DF_OpOp_X", targetPos, "DFX") end
                                if isReady("DFC") then useSkill("DF_OpOp_C", targetPos, "DFC") end
                                if isReady("DFV") then useSkill("DF_OpOp_V", targetPos, "DFV") end
                            end
                        end
                    end
                end
            end
        end)
        
        if not ok then
            warn("[KL-DELTA] Loop error: " .. tostring(err))
        end
    end
end)

-- Анти-АФК для Мобилок (без VirtualUser и хуйни с мышой)
local GC = getconnections or get_signal_cons
if GC then
    for i,v in pairs(GC(LocalPlayer.Idled)) do
        if v["Disable"] then
            v:Disable()
        elseif v["Disconnect"] then
            v:Disconnect()
        end
    end
else
    -- Запасной вариант через хук __namecall, если getconnections нет
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" or method == "kick" then
            return -- шлём нахуй любые кики
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

