-- 4. ОСНОВНОЙ ЦИКЛ ФАРМА
task.spawn(function()
    while autoDungeon do
        task.wait(0.05)
        
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart

            checkAndHeal()

            local currentFloor = getFloorText()
            if currentFloor then
                if currentFloor ~= lastFloor then
                    print("[KL-DELTA] Этаж: " .. currentFloor)
                    if isRoomActive() then toggleRoom(hrp.CFrame) end
                    lastFloor = currentFloor
                end

                if string.find(currentFloor, "/5") then
                    local mob = getValidMob()
                    if mob then
                        local mobHRP = mob:FindFirstChild("HumanoidRootPart")
                        if not mobHRP then return end
                        local targetPos = mobHRP.CFrame
                        
                        -- Висим прямо над мобом, смотрим вниз
                        hrp.CFrame = targetPos * CFrame.new(0, 15, 0) * CFrame.Angles(math.rad(-90), 0, 0)

                        if not isRoomActive() then
                            toggleRoom(targetPos)
                            task.wait(1.5)
                        elseif isRoomActive() and not isPlayerInRoom() then
                            toggleRoom(hrp.CFrame)
                            task.wait(1)
                            toggleRoom(hrp.CFrame)
                            task.wait(1.5)
                        else
                            -- Бесконечный спам M1
                            pcall(function()
                                SkillAction:InvokeServer("SW_Kioru V2_M1", { ["MouseHit"] = targetPos })
                            end)

                            -- Спам остальных скиллов ровно раз в секунду
                            if tick() - lastSkillTime >= 1 then
                                fireSkill("SW_Kioru V2_Z", targetPos)
                                fireSkill("SW_Kioru V2_X", targetPos)
                                
                                if isRoomActive() then
                                    fireSkill("DF_OpOp_X", targetPos)
                                    fireSkill("DF_OpOp_C", targetPos)
                                    fireSkill("DF_OpOp_V", targetPos)
                                end
                                
                                lastSkillTime = tick()
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- 5. АНТИ-АФК ДЛЯ МОБИЛОК
local GC = getconnections or get_signal_cons
if GC then
    for i,v in pairs(GC(LocalPlayer.Idled)) do
        if v["Disable"] then
            v:Disable()
        elseif v["Disconnect"] then
            v:Disconnect()
        end
    end
else
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" or method == "kick" then
            return
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

